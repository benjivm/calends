        "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
        "@vitejs/plugin-vue": "^6.0.10",
        "prettier": "^3.9.10",
        "typescript": "^6.0.3",
        "vite": "^8.3.4",
        "vitest": "^5.0.5",
        "vue-tsc": "^3.3.13"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/benjivm/calends.git"
    }
