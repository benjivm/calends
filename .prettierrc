{
    "tabWidth": 4,
    "printWidth": 100,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "all",
    "htmlWhitespaceSensitivity": "css",
    "singleAttributePerLine": true,
    "plugins": ["@ianvs/prettier-plugin-sort-imports"],
    "importOrder": ["^vue$", "^@(?!/).*$", "<THIRD_PARTY_MODULES>", "^[.]"],
    "importOrderTypeScriptVersion": "5.0.0",
    "overrides": [
        {
            "files": ["*.css", "*.scss"],
            "options": {
                "tabWidth": 2
            }
        }
    ]
}
